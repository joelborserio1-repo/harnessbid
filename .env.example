# Safe for browser use. Supabase anon access is still constrained by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin only. Never expose this in client components, browser bundles, or NEXT_PUBLIC vars.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Phase 17). Server-only secrets must never be NEXT_PUBLIC. ---
# Publishable key is safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional commercial fee overrides (USD whole dollars). Default 0 = free listings.
FEE_HORSE_LISTING_USD=
FEE_MARKETPLACE_LISTING_USD=
FEE_FEATURED_UPGRADE_USD=
